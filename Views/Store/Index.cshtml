@{
}

@model FurByte.ViewModels.StorePageViewModel
@await Html.PartialAsync("_StorePartial", Model)


 <!-- Store Modal -->
<div class="modal fade" id="storeModal" tabindex="-1" role="dialog" aria-labelledby="storeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="storeModalLabel">Pet Store</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="storeContent">
                <!-- Store content will be loaded here -->

            </div>
        </div>
    </div>
</div>