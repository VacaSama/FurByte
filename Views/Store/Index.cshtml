@{
	ViewData["Title"] = "Pet Store";
}

@model FurByte.ViewModels.StorePageViewModel
@await Html.PartialAsync("_StorePartial", Model)

<div id="closeStoreBtn" class="btn btn-close">Close Store</div>
 <!-- Store Modal -->
<div id="storeModal" class="modal">
    <div class="modal-content">
        <span id="closeBtn">&times;</span>
        <p>Hello, I’m a modal!</p>
    </div>
    <partial name="_StorePartial" />
</div>
