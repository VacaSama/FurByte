@*
    STORE PARTIAL VIEW -- displays adoptable pets and pet products for purchase.
    This is a popup modal that should should all available pets and products

*@
@{
    // C# code goes here 
}
@model FurByte.ViewModels.StorePageViewModel
<!-- The link below is for modal insertion -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<h2> Adoptable Pets!</h2>
@if(Model?.Pets != null ) {
    @foreach (var pet in Model.Pets)
    {
        <div>
            <div class="card" style="width: 18rem;">
                <img src="@pet.ImageUrl" class="card-img-top" alt="pet_pfp">
                <div class="card-body">
                <!-- Cat, Female -->
                    <h5 class="card-subtitle">@pet.PetType, @pet.PetGender</h5>
                    <span>"Price: @pet.PetFee"</span>

                <!-- purchase button below-->
                    <a href="" class="btn btn-primary">Purchase</a>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No pets available right now.</p>
}


<h2>Pet Products!</h2>

@if(Model?.Products != null ) {
    @foreach (var product in Model.Products)
    {
        <div>
            <div class="card" style="width: 18rem;">
                <img src="@product.ImageUrl" class="card-img-top" alt="product_img">
                <div class="card-body">
                <!-- Golden Boy'o Biscuits, Treats' -->
                    <h5 class="card-subtitle">@product.ProductName, @product.Category</h5>
                    <p class=" card-text">@product.Description</p>
                    <span>"Price: @product.Price"</span>

                <!-- purchase button below-->
                    <a href="" class="btn btn-primary">Purchase</a>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No pet products available right now.</p>
}
