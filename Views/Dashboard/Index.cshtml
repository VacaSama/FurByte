@*
    This is the PET DASHBOARD VIEW ------- 
    the user can view their pets stats here. Increase them by 
    interacting with the pet.
*@
@{
    ViewData["Title"] = "Dashboard";
}

@model FurByte.ViewModels.DashboardViewModel
@await Html.PartialAsync("_StorePartial", Model)


<!-- PET DASHBOARD TITLE-->
<div class="text-center">
    <h1 class="display-4">Pet Dashboard</h1>
</div>

<!--STORE MODAL TO DISPLAY ADOPTABLE PETS AND PRODUCTS-->
<div>
    <a id="store-button" href="#" class="btn btn-outline-secondary">Pet Store</a>

    <div class="modal fade" id="storeModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Store</h5>
                    <button id="closeStoreBtn" class="btn-close" data-bs-dismiss="modal"></button>

                </div>
                    <div id="storeModalBody" class="modal-body">
                </div>

            </div>
        </div>
    </div>
</div>

<!-- The progress bars are below, they need to be in their own div class
    to avoid stretching across the entire page.

    The style will later be changed to have the decay logic
-->
<div class="card d-flex flex-column gap-3" style="width: 18rem;">
    <div class="card-header">Pet Needs:</div>

    <div class="card-text">Happiness:</div>
    <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="@Model.Stats.Happiness" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 75%" id="HappyBar"></div>
    </div>

    <div class="card-text">Energy:</div>
    <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="@Model.Stats.Energy" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 50%" id="EnergyBar"></div>
    </div>

    <div class="card-text">Hunger:</div>
    <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="@Model.Stats.Hunger" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 50%" id="HungerBar"></div>
    </div>

    <div class="card-text">Hygiene:</div>
    <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="@Model.Stats.Hygiene" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 50%" id="HygieneBar"></div>
    </div>
</div>

<!-- Instead of making a pet profile the pet will just appear here :) -->
    <canvas id="furbyteCanvas"></canvas>

<!-- Interaction Card for ways for the user to keep the pet happy.-->
<div id ="interaction-panel" class="card gap-2">
    <div class="card-header">Interactions Panel:</div>
    <div>
        <button id="panel-button" class="btn" type="button">Play</button>
        <button id="panel-button" class="btn" type="button">Bathe</button>
    </div>
    
    <div>
        <button id="panel-button" class="btn" type="button">Feed</button>
        <button id="panel-button" class="btn" type="button">Pet</button>
    </div>

    <!-- this button may need to be changed to <a>-->
    <div>
        <button id="panel-button" class="btn" type="button">Rehome Pet*ph*</button>
    </div>

</div>
