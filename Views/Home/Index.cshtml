@{
    ViewData["Title"] = "Landing Page";
}

<!-- Home/Landing Page of Furbyte-->
<div class="d-flex align-items-center justify-content-start" style=" height: 100vh;">
    <div class=" text-start">
        <h1 class="display-4">Welcome to FurByte</h1>
        <h2> Your Pixel-based, Fuzzy companion.</h2>

        asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"

        <div class="align-items-center mb-2" id="landing-page-btn">
            <button class="btn btn-dark" asp-area="Identity" asp-page="/Account/Register">Register</button>
            <button class="btn" asp-area ="Identity" asp-page ="/Account/Login">Login</button>
        </div>
    </div>

    <div class="align-items-end p-4">
        <img src="~/images/FURBYTE-LOGO.png" alt="FurByte-LOGO" style=" max-width: 75%; height: auto;margin-left: 90px;" />
    </div>
</div>


