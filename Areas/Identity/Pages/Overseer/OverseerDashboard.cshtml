@page
@model FurByte.Areas.Identity.Pages.Overseer.OverseerDashboardModel
@{
    ViewData["Title"] = "Overseer Dashboard";
    /* ADD FOREACH LOOP; FOR THE TWO DIFFERENT TEMPLATES (P1=>P2) (P1=>OVR)
    // CREATE ANOTHER MODAL FOR THE USER REHOME REQUEST FORM (POP-UP WINDOW)
    // TWO BUTTON OPTIONS TO GIVE A PET TO A FRIEND OR BACK TO THE OVERSEERS
    // A TEXT BOX FOR REASONING, SUBMIT BUTTON, WHICH PET THEY ARE REHOMING...ETC
    */ 
}

<h1>Welcome, @Model.OverseerFirstName @Model.OverseerLastName</h1>


@if(Model.RehomeRequests != null)
{
    @foreach (var request in Model.RehomeRequests)
    {
        <div class="card g-col-6" style="width: 25rem;">
            <p class="card-title">Rehome Request for: @request.OwnerId</p>
            <p class="card-subtitle">@request.Owner</p>
            <p class="card-subtitle">(Receiver)User/Player Username PlaceHolder:</p>
            <p class="card-subtitle">@request.PetName</p>
            <p class="card-body">
                @request.Owner is requesting to rehome @request.PetName back to the Overseers.
                <br />
                Reason for Rehome: @request.ReasonForRehome<br />
                Overseer @Model.OverseerFirstName, do you Approve or Deny this request?
                <br />
            </p>
            <form method="post" action="/RehomeRequest/Approve">
                <input type="hidden" name="id" value="@request.RehomeRequestId" />
                <button type="submit">Approve</button>
            </form>

            <form method="post" action="/RehomeRequest/Deny">
                <input type="hidden" name="id" value="@request.RehomeRequestId" />
                <button type="submit">Deny</button>
            </form>

        </div>

    }
}

else {
    <p>You have no Rehome Requests to Review.</p>
}

