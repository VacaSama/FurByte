@page
@model FurByte.Areas.Identity.Pages.Overseer.OverseerDashboardModel
@{
    ViewData["Title"] = "Overseer Dashboard";
}

<h1>Welcome, @Model.OverseerFirstName @Model.OverseerLastName</h1>
<div class="grid text-center">
    <div class="card g-col-6" style="width: 25rem;">
        <p class="card-title">Rehome Request Placeholder:</p>
        <p class="card-subtitle">(Sender)User/Player Username PlaceHolder:</p>
        <p class="card-subtitle">(Receiver)User/Player Username PlaceHolder:</p>
        <p class="card-subtitle">(Sender)Pet Name & PetId</p>
        <p class="card-body">{User} is requesting to rehome {Users Pet}, this will relinquish 
            ownership from {User} to {Receiving Player}.
            <br />
            Overseer @Model.OverseerFirstName, do you Approve or Deny this request?
        </p>
        <button type="button" class="btn btn-light">Approve</button>
        <button type="button" class="btn btn-primary">Deny</button>
    </div>
    <!-- These are just templates to cards the Overseer may get. -->
    <div class="card g-col-6" style="width: 25rem;">
        <p class="card-title">Rehome Request Placeholder:</p>
        <p class="card-subtitle">(Sender)User/Player Username PlaceHolder:</p>
        <p class="card-subtitle">(Receiver)User/Player Username PlaceHolder:</p>
        <p class="card-subtitle">(Sender)Pet Name & PetId</p>
        <p class="card-body">
            {User} is requesting to rehome {Users Pet} back to the Overseers.
            <br />
            Overseer @Model.OverseerFirstName, do you Approve or Deny this request?
        </p>
        <button type="button" class="btn btn-light">Approve</button>
        <button type="button" class="btn btn-primary">Deny</button>
        
    </div>

</div>
